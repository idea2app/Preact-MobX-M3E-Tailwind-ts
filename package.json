{
  "name": "@idea2app/preact-mobx-m3e-tailwind-ts",
  "version": "1.0.0",
  "author": "twcbnubio@gmail.com",
  "homepage": "https://idea2app.github.io/Preact-MobX-M3E-Tailwind-ts/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/idea2app/Preact-MobX-M3E-Tailwind-ts.git"
  },
  "bugs": {
    "url": "https://github.com/idea2app/Preact-MobX-M3E-Tailwind-ts/issues"
  },
  "dependencies": {
    "@lit/react": "^1.0.8",
    "@m3e/react": "^2.1.3",
    "@m3e/web": "^2.1.3",
    "@tailwindcss/postcss": "^4.2.2",
    "browser-unhandled-rejection": "^1.0.2",
    "idb-keyval": "^6.2.2",
    "koajax": "^3.3.0",
    "lit": "^3.3.2",
    "lodash": "^4.17.23",
    "mobx": "^6.15.0",
    "mobx-github": "^0.6.2",
    "mobx-i18n": "^0.7.2",
    "mobx-react": "^9.2.1",
    "mobx-react-helper": "^0.5.1",
    "mobx-restful": "^2.1.4",
    "preact": "^10.29.0",
    "react": "npm:@preact/compat@^18.3.2",
    "react-dom": "npm:@preact/compat@^18.3.2",
    "react-router": "^7.13.2",
    "react-router-class-tools": "^0.2.3",
    "react-router-dom": "^7.13.2",
    "tailwindcss": "^4.2.2",
    "web-utility": "^4.6.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.10",
    "@parcel/config-default": "~2.16.4",
    "@parcel/packager-raw-url": "~2.16.4",
    "@parcel/transformer-typescript-tsc": "~2.16.4",
    "@parcel/transformer-webmanifest": "~2.16.4",
    "@types/lodash": "^4.17.24",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "parcel": "~2.16.4",
    "postcss": "^8.5.8",
    "process": "^0.11.10",
    "typescript": "~5.9.3",
    "workbox-cli": "^7.4.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@swc/core",
      "lmdb",
      "msgpackr-extract"
    ]
  },
  "alias": {
    "react": "preact/compat",
    "react-dom": "preact/compat",
    "react/jsx-runtime": "preact/jsx-runtime"
  },
  "@parcel/resolver-default": {
    "packageExports": true
  },
  "lint-staged": {
    "*.{js,ts,cjs,mjs,d.ts,d.cts,d.mts,jsx,tsx,json,jsonc}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "scripts": {
    "prepare": "husky",
    "test": "lint-staged",
    "lint": "biome check --write --assist-enabled=true --no-errors-on-unmatched",
    "clean": "rm -rf .parcel-cache/ dist/",
    "start": "npm run clean  &&  parcel src/index.html",
    "pack": "npm run clean  &&  parcel build src/index.html --public-url .",
    "build": "npm run pack  &&  workbox generateSW"
  }
}
